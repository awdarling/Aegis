# Aegis environment variables
# Copy this file to .env and fill in real values — never commit .env

# ── Runtime ───────────────────────────────────────────────────────────────────
# "development" | "production" | "test"
NODE_ENV=production

# Port the HTTP server listens on. Railway injects $PORT automatically.
PORT=3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Full project URL from Supabase → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key from Supabase → Settings → API → Project API keys.
# This key bypasses Row Level Security — never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Telnyx (SMS provider) ─────────────────────────────────────────────────────
# All OPTIONAL. When unset, Aegis boots email-first (outbound SMS is skipped and
# the inbound SMS webhook rejects unsigned requests). The sending NUMBER is NOT
# here — each tenant's own Telnyx number lives in company_channels
# (channel_type='sms'), resolved per-tenant, so this config is number-agnostic.
#
# v2 API key (Bearer) for outbound send — Telnyx Portal → Account Settings → Keys
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Base64 Ed25519 public key used to verify inbound webhook signatures —
# Telnyx Portal → Account Settings → Keys & Credentials → Public Key
TELNYX_PUBLIC_KEY=your_base64_ed25519_public_key
# The messaging profile the number belongs to (portal/webhook config; not sent
# in the request body — it is bound to the number server-side). Optional.
TELNYX_MESSAGING_PROFILE_ID=

# Set to "true" ONLY for local / Tier-0 testing so unsigned simulated inbound
# requests pass signature verification. NEVER set in production.
SKIP_TELNYX_VERIFICATION=

# EMAIL-ONLY MODE — default "true". While true, SMS is fully disabled and every
# workflow runs over email. Set to "false" (and configure Telnyx above) to enable
# the SMS path (sandbox/testing). Production stays "true" until go-live.
EMAIL_ONLY=true

# ── SendGrid ──────────────────────────────────────────────────────────────────
# API key with Mail Send and Inbound Parse permissions
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must be a verified sender identity or authenticated domain in SendGrid
SENDGRID_FROM_EMAIL=aegis@mail.yourdomain.com

# Display name shown in the From field of outbound emails (optional, default: Aegis)
SENDGRID_FROM_NAME=Aegis

# Optional: SendGrid signed event webhook verification key for inbound parse
# Found in SendGrid → Settings → Inbound Parse → Signature Verification
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Service ───────────────────────────────────────────────────────────────────
# Public HTTPS URL of this deployed service — no trailing slash.
# Required in production: used to generate Approve/Deny links in manager emails.
# Example: https://aegis-production.up.railway.app
BASE_URL=https://your-aegis-url.up.railway.app

# Base URL of the Homebase Next.js app (no trailing slash).
# Used by aegis-actions to construct magic-link URLs that point back to Homebase
# (e.g. one-click TO approve/deny, availability approve/deny, emergency coverage).
# Example: https://homebase-nine-phi.vercel.app
HOMEBASE_URL=https://homebase-nine-phi.vercel.app

# Shared bearer token for /internal/* endpoints. Homebase POSTs to these
# endpoints from its aegis-action dispatcher to trigger employee notifications
# (TO decisions, schedule distribution). The SAME value must be set as
# AEGIS_INTERNAL_SECRET in the Homebase Vercel project. Cryptographically
# random 64-char hex recommended:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AEGIS_INTERNAL_SECRET=
